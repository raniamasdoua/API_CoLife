DB_HOST=localhost
DB_PORT=5432
DB_NAME=colife_db
DB_USER=colife_user
DB_PASSWORD=colife_password

# Keycloak (OIDC)
# Émetteur des tokens validés par le backend (resource server).
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/colife
# Compte admin de la console Keycloak (http://localhost:8081)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
